# Authorized-import map for the preserved live resources.
# This file is documentation only: copy each block into a local, ignored
# imports file after an operator confirms the live identifiers, then remove
# the block after the import has been recorded in committed state metadata.
#
# Example workflow:
#   cp imports.tf.example imports.tf   # imports.tf is ignored by .gitignore
#   terraform init -backend-config=backend.hcl
#   terraform plan -out=tfplan         # reviewer confirms no replacements
#   terraform apply tfplan              # authorized operator only
#   terraform state list                # capture imported addresses/IDs
#   rm imports.tf tfplan
#
# import {
#   # Preserved production VPS as an import-only protected record.
#   # Import ID is the OVH service name; the resource ignores all changes
#   # and forbids destruction.
#   to = ovh_vps.preserved[0]
#   id = "REPLACE_WITH_OVH_SERVICE_NAME"
# }


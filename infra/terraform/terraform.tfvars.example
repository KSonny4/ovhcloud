# Copy to terraform.tfvars (ignored) only after the operator approves the domain.
# Do not commit the copy or any provider credentials.
cloudflare_api_token    = "REPLACE_WITH_EXTERNAL_SECRET"
cloudflare_account_id   = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
cloudflare_tunnel_secret = "REPLACE_WITH_BASE64_TUNNEL_SECRET"
openbao_address          = "https://secrets.pkubelka.cz"
openbao_token            = "REPLACE_WITH_OPENBAO_RUNNER_TOKEN"
domain                  = "REPLACE_WITH_APPROVED_DOMAIN"
ovh_ipv4                = "198.51.100.10" # TEST-NET-2 placeholder; replace from ovhcloud CLI.
ovh_service_name        = "vps-REPLACE_WITH_SERVICE_NAME.vps.ovh.net"
admin_emails            = ["ksonny4@gmail.com"]
r2_bucket_name          = "ovh-coolify-backups"
manage_application_wildcard = false
access_service_token_name = "ovh-coolify-machine-verification"
access_service_token_duration = "1y"
provision_ovh_vps       = false

# Only needed when intentionally ordering a new VPS rather than importing the existing one.
# ovh_subsidiary = "REPLACE_WITH_BILLING_SUBSIDIARY"
# ovh_datacenter  = "REPLACE_WITH_OVH_DATACENTER"
# ovh_plan_code   = "REPLACE_WITH_APPROVED_PLAN_CODE"

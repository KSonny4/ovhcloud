          "datasourceUid": "grafanacloud-prom",
          "model": {
            "expr": "(time() - (max(pg_shared_job_last_success_timestamp_seconds{job=\"pg-shared\",run_kind=~\"backup-full|backup-diff\"}) or on() vector(0))) and on() (max(pg_up{job=\"pg-shared\"}) == 1)",
            "intervalMs": 60000,
            "maxDataPoints": 43200,
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0

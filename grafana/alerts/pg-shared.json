          "datasourceUid": "__expr__",
          "model": {
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "reducer": "last",
            "refId": "B",
            "type": "reduce",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "$B > 93600",
            "refId": "C",
            "type": "math",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",

      "annotations": {
        "summary": "The newest successful pgBackRest backup (full or diff, from ops.job_runs) is older than 26 hours; backups are scheduled daily from 01:00 UTC. No recorded success at all also fires.",
        "runbook": "KSonny4/nomad-postgresql docs/runbooks/ (pg-shared); alerts listed in docs/cd-exception.md"
      },
      "labels": {
        "service": "pg-shared",
        "severity": "critical"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "keeper-telegram"
      }
